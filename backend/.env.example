# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Postgres123
POSTGRES_DB=aiwse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:Postgres123@localhost:5432/aiwse_db

# --- Auth ---
# This service only VALIDATES incoming JWTs issued by the parent
# "AI Internship Simulator" platform (Module 1). It never issues tokens itself.
JWT_SECRET_KEY=change-me-to-the-shared-signing-secret
JWT_ALGORITHM=HS256

# --- AI ---
# Leave empty to use the built-in deterministic mock AI provider.
# Set this later to switch AIService over to real Gemini calls with zero code changes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.json,.yaml,.yml,.md,.txt,.csv,.zip,.pdf,.png,.jpg,.jpeg,.gif,.html,.css,.sql,.sh,.dockerfile,.toml,.ini,.cfg,.conf,.xml,.java,.kt,.rb,.go,.rs,.cs,.php,.swift,.scala,.clj,.hs,.ml,.fs,.vb,.pl,.r,.m,.lua,.dart,.elm,.ex,.exs,.erl,.hrl,.pp,.tf,.tfvars,.hcl,.nomad,.helm,.k8s
UPLOAD_DIRECTORY=storage/submissions
